MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_DATABASE=rcc
MYSQL_USER=rcc_admin
MYSQL_PASSWORD=local-admin-password
ADMIN_API_TOKEN=replace-with-a-long-random-local-token
ADMIN_OPERATOR=local-admin
ADMIN_CORS_ORIGINS=http://127.0.0.1:5173
MYSQL_PUBLISHED_PORT=3306
ADMIN_PUBLISHED_PORT=8080

# Explicit same-origin account entry (development loopback only).
ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:5173
ADMIN_ALLOW_LOCAL_HTTP=true
