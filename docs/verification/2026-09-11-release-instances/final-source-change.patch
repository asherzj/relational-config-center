+	assertIntegrationErrorCode(t, stale, 409, "release_version_conflict")
+	removal := fmt.Sprintf(`{"title":"草稿增删表","expected_version":"2","changes":{"upserts":[],"delete_detail_ids":[%q]}}`, detail.DetailID)
