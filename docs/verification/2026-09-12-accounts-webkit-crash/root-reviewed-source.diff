diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 05566df..a783286 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -150,6 +150,7 @@ jobs:
 
       - name: Run isolated browser acceptance
         env:
+          DEBUG: pw:browser
           RCC_E2E_ARTIFACTS: ${{ runner.temp }}/rcc-browser-acceptance
           RCC_E2E_ENGINES: chromium,firefox,webkit
         run: make test-browser-acceptance
@@ -163,6 +164,67 @@ jobs:
           if-no-files-found: error
           retention-days: 14
 
+  # Temporary #110 native crash evidence; remove this job and its sampler once
+  # the renderer failure has an evidenced resolution. Existing gates stay intact.
+  accounts-webkit-native-diagnostic:
+    name: Accounts WebKit native diagnostic
+    if: github.event_name == 'pull_request' && github.event.pull_request.number == 111
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - name: Check out repository
+        uses: actions/checkout@v7
+      - name: Set up pnpm
+        uses: pnpm/action-setup@v6
+        with:
+          version: 10.28.2
+      - name: Set up Node.js
+        uses: actions/setup-node@v7
+        with:
+          node-version: 24.19.0
+          cache: pnpm
+          cache-dependency-path: web/pnpm-lock.yaml
+      - name: Set up Go
+        uses: actions/setup-go@v7
+        with:
+          go-version-file: go.work
+          cache-dependency-path: |
+            go.work.sum
+            admin/go.sum
+      - name: Observe the original isolated accounts case
+        env:
+          DEBUG: pw:browser
+          RCC_E2E_ARTIFACTS: ${{ runner.temp }}/rcc-accounts-webkit-browser
+          RCC_NATIVE_ARTIFACTS: ${{ runner.temp }}/rcc-accounts-webkit-native
+          RCC_E2E_SUITE: release-workflow
+          RCC_E2E_ENGINES: webkit
+          RCC_E2E_CASES: accounts.mjs@webkit
+        run: |
+          mkdir -p "$RCC_NATIVE_ARTIFACTS"
+          node scripts/diagnose-accounts-webkit-native.cjs "$RCC_NATIVE_ARTIFACTS/resources.jsonl" &
+          diagnostic_pid=$!
+          stop_diagnostic() {
+            kill "$diagnostic_pid" 2>/dev/null || true
+            wait "$diagnostic_pid" 2>/dev/null || true
+          }
+          trap stop_diagnostic EXIT
+          make test-browser-acceptance
+      - name: Collect kernel crash and OOM messages
+        if: always()
+        run: |
+          mkdir -p "${{ runner.temp }}/rcc-accounts-webkit-native"
+          sudo dmesg --ctime --level=emerg,alert,crit,err,warn > "${{ runner.temp }}/rcc-accounts-webkit-native/kernel-warnings.log" 2>&1 || true
+      - name: Upload native diagnostic evidence
+        if: always()
+        uses: actions/upload-artifact@v6
+        with:
+          name: accounts-webkit-native-${{ github.run_id }}-${{ github.run_attempt }}
+          path: |
+            ${{ runner.temp }}/rcc-accounts-webkit-browser
+            ${{ runner.temp }}/rcc-accounts-webkit-native
+          if-no-files-found: error
+          retention-days: 14
+
   compose-migrations:
     name: Goose Compose deployment
     runs-on: ubuntu-latest
